# ================================================================
# SAHAKARI SHRAMIK - BACKEND CONFIGURATION
# ================================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
# Local: mongodb://localhost:27017/sahakari_shramik
# Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sahakari_shramik?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/sahakari_shramik

# JWT Secret & Expiration
JWT_SECRET=sahakari_shramik_secure_jwt_secret_key_2026_sih
JWT_EXPIRE=30d
